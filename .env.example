# Copiar este archivo como .env y completar la contraseña.
# Generar una contraseña segura con:
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
POSTGRES_USER=admin
POSTGRES_PASSWORD=cambiar_esto
POSTGRES_DB=questions_db
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Clave para usar los endpoints que modifican datos (POST y PUT).
# Generarla con el mismo comando que la contraseña. Si queda vacía,
# la API funciona igual pero no permite crear ni modificar datos.
API_KEY=