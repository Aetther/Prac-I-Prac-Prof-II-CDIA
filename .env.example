# Copiar este archivo como .env y completar la contraseña.
# Generar una contraseña segura con:
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
POSTGRES_USER=admin
POSTGRES_PASSWORD=cambiar_esto
POSTGRES_DB=questions_db
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Clave para los endpoints de administración (ver las respuestas, crear y
# corregir). Generarla con el mismo comando que la contraseña. Si queda vacía,
# el juego y las estadísticas funcionan igual, pero la administración no.
API_KEY=

# Documentación interactiva (/docs). Poner false para ocultarla, por ejemplo
# si la API se publica en internet.
ENABLE_DOCS=true